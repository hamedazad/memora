# Memora Core Server Configuration
# Copy this to .env for your server setup

# PostgreSQL Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=memora_db
DB_USER=memora_user
DB_PASSWORD=memora_password_2024
DB_HOST=localhost
DB_PORT=5432

# Django Settings
SECRET_KEY=django-insecure-your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-server-ip

# CORS Settings for Mobile App
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOW_CREDENTIALS=True

# API Settings
OPENAI_API_KEY=your-openai-api-key-here

# Server Settings
SERVER_MODE=production
SERVE_MOBILE=True


